cat > .gitignore << 'EOF'
# Java
*.class
*.jar
*.war
*.ear
hs_err_pid*

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse
.classpath
.project
.settings/

# VS Code
.vscode/

# macOS
.DS_Store
._*

# Windows
Thumbs.db

# Logs
*.log

# Local config
local.properties
.env
.env.local
EOF